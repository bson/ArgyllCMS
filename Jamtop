# Generate Wayland client glue for one protocol:
#   WaylandProtocol basename : protocol.xml ;
# produces basename.h and basename.c in the current directory. List
# basename.c among the sources of whatever uses it, and make that
# source's objects depend on basename.h, since Jam's header scan runs
# before the header exists.
rule WaylandProtocol
{
	local _h = [ NormIDstTargets $(<).h ] ;
	local _c = [ NormIDstTargets $(<).c ] ;
	MakeLocate $(_h) $(_c) ;
	Depends files : $(_h) $(_c) ;
	NotFile $(>) ;
	WaylandHeader $(_h) : $(>) ;
	WaylandCode $(_c) : $(>) ;
	Clean clean : $(_h) $(_c) ;
}

actions WaylandHeader
{
	wayland-scanner client-header $(>) $(<)
}

actions WaylandCode
{
	wayland-scanner private-code $(>) $(<)
}
